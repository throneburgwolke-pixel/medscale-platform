# ─────────────────────────────────────────────────────────────────────────────
# 医学量表与问卷平台 · 容器版环境变量
#
#   cp deploy/docker.env.example deploy/docker.env
#   # 改掉下面的管理员口令
#
# 注意与宿主机版的区别：这里的 MEDSCALE_DB 指向容器内的 /data，
# 对应 docker-compose.yml 里的 medscale-data 数据卷。
# 千万不要照抄 medscale.env.example 里的 /var/lib/medscale —— 容器里没有那个目录。
# ─────────────────────────────────────────────────────────────────────────────

PORT=5173

# 容器内的路径，对应 medscale-data 卷
MEDSCALE_DB=/data/app.db

# 必改：12 位以上强口令。只在「库里还没有管理员口令」时用来初始化，不会覆盖后来改的。
MEDSCALE_PASSWORD=换成你自己的强口令_至少12位_含大小写数字符号

# 反代在同一个 compose 里（caddy 服务），必须开；否则收不到真实来源 IP，
# 也不会下发 HSTS 与 Secure Cookie。
MEDSCALE_TRUST_PROXY=1

# 单进程足够；容器里开多进程收益有限，SQLite 写锁竞争反而更明显
MEDSCALE_WORKERS=1

# 保持默认 noindex；确认要搜索引擎收录才打开
# MEDSCALE_INDEXABLE=1

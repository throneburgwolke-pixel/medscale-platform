# ─────────────────────────────────────────────────────────────────────────────
# 医学量表与问卷平台 · 服务端环境变量
#
# 用法：
#   sudo cp deploy/medscale.env.example /etc/medscale.env
#   sudo nano /etc/medscale.env          # 改掉下面所有标注「必改」的行
#   sudo chmod 600 /etc/medscale.env     # 里面有明文口令，只让 root 读
#
# 这个文件由 systemd 通过 EnvironmentFile= 读入，文件名必须是 /etc/medscale.env。
# 改完记得：sudo systemctl restart medscale
# ─────────────────────────────────────────────────────────────────────────────

# ── 监听 ─────────────────────────────────────────────────────────────────────
PORT=5173

# 不要设 MEDSCALE_LAN。反向代理模式下应用只听 127.0.0.1，
# 公网入口只有 Caddy 的 443，5173 永远不对外暴露。

# ── 数据 ─────────────────────────────────────────────────────────────────────
# 库文件与它同级的 backups/ 都在这里。这个目录是应用唯一需要写权限的地方，
# 备份、升级、迁移都只需搬这一个目录。
MEDSCALE_DB=/var/lib/medscale/app.db

# ── 反向代理 ─────────────────────────────────────────────────────────────────
# 必改：确实部署在 Caddy/Nginx 后面才设 1。
# 设了才会认 X-Forwarded-For（登录限流与操作日志取真实来源 IP）
# 和 X-Forwarded-Proto: https（下发 HSTS 与带 Secure 的 Cookie）。
MEDSCALE_TRUST_PROXY=1

# ── 管理员口令 ───────────────────────────────────────────────────────────────
# 必改：设成 12 位以上、字母+数字+符号的强口令。
#
# 语义（已核对源码 lib/db.js 的 ensureAdminPasswordHash）：
#   只在「数据库里还没有管理员口令」时用它初始化，**不会覆盖你后来改过的口令**。
#   不设的话，首次启动会自动生成 16 位随机口令（打印在启动日志并写入数据目录的
#   「管理员初始口令.txt」，改密后自动删除）——所以不设也安全，但自己设更便于记忆。
#
# 因此：首次启动前必须填好这一行，确认能登录后可以把它注释掉（更安全），
# 之后再改密码走网页「系统设置 → 修改管理员密码」。
MEDSCALE_PASSWORD=换成你自己的强口令_至少12位_含大小写数字符号

# ── 并发 ─────────────────────────────────────────────────────────────────────
# 单进程（默认）足以支撑百人级问卷发放，不必开。
# 确有大并发再改成 max（按 CPU 核数）或具体数字（封顶 16）。
# 会话与限流计数已落库，多进程天然共享，但进程越多 SQLite 写锁竞争越明显。
MEDSCALE_WORKERS=1

# ── 搜索引擎收录 ─────────────────────────────────────────────────────────────
# 不设 = 保持 X-Robots-Tag: noindex（含受试者数据的站点不该出现在搜索结果里）。
# 只有确认要让搜索引擎收录时才取消下面这行的注释。
# MEDSCALE_INDEXABLE=1

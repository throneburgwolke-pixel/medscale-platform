# ─────────────────────────────────────────────────────────────────────────────
# 医学量表与问卷平台 · systemd 服务单元
#
# 安装位置：/etc/systemd/system/medscale.service
# 启用：    sudo systemctl daemon-reload && sudo systemctl enable --now medscale
#
# 这里最关键的一条是 Restart=always —— 服务器重启、进程崩溃、被 OOM 杀掉，
# 都由 systemd 自动拉回来，不需要人守着一台开了终端的窗口。
# ─────────────────────────────────────────────────────────────────────────────

[Unit]
Description=医学量表与问卷平台（量表库 / 问卷发放 / 数据回收与统计）
Documentation=file:/opt/medscale/deploy/README.md
After=network-online.target
Wants=network-online.target

# 端口被占用时应用会主动 exit(1)（它拒绝顺延端口，否则已发出的二维码全失效）。
# 没有熔断的话 systemd 会无限重启刷日志，所以这里限定：300 秒内最多重启 5 次，
# 超过就停下并标记为 failed，等人来看 —— 这正是我们想要的提示方式。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=medscale
Group=medscale
WorkingDirectory=/opt/medscale
EnvironmentFile=/etc/medscale.env
ExecStart=/usr/bin/node server.js

# 崩溃/重启机器后自动恢复
Restart=always
RestartSec=3

# 优雅退出：应用自己处理 SIGTERM（30 秒收尾窗口，排空在途请求后删掉运行地址文件）。
# TimeoutStopSec 必须大于应用自己的收尾窗口，否则 systemd 会提前 SIGKILL。
KillSignal=SIGTERM
TimeoutStopSec=45
KillMode=mixed

# ── 加固：这个进程只需要「读代码 + 写数据目录」两件事 ────────────────────────
# 代码目录 /opt/medscale 与 /etc/medscale.env 一律只读，
# 整个文件系统除 /var/lib/medscale 外都不可写。
ProtectSystem=strict
ReadWritePaths=/var/lib/medscale
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# 日志进 journald：journalctl -u medscale -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=medscale

[Install]
WantedBy=multi-user.target
